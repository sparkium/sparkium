{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@sparkium/types",
  "projectType": "library",
  "sourceRoot": "libs/types/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "generate-schemas"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "generate-schemas": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist/schemas"
      ],
      "options": {
        "command": "node --import tsx/esm scripts/generate-schemas.ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    }
  }
}
