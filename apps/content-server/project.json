{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@sparkium/content-server",
  "projectType": "application",
  "sourceRoot": "apps/content-server/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --watch src/index.ts",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "bun build src/index.ts --target bun --outdir dist",
        "cwd": "{projectRoot}"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist/content-server"
      ],
      "options": {
        "command": "bun build src/index.ts --compile --outfile dist/content-server",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "engine": "docker",
        "load": true,
        "push": false,
        "tags": [
          "sparkium/content-server:latest"
        ],
        "platforms": [
          "linux/amd64"
        ],
        "context": "{workspaceRoot}",
        "file": "apps/content-server/Dockerfile"
      }
    }
  }
}
